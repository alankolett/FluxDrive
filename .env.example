# FluxDrive — Secure Workspace Configuration

# Groq API Configuration (Powers AI Copilot with LPU inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# MongoDB Connection (MongoDB Atlas or local)
MONGO_URI=mongodb://localhost:27017
DB_NAME=fluxdrive

# Security & HMAC Signing
SECRET_KEY=fluxdrive-sec-token-hmac-sha256-signature-key-2026
